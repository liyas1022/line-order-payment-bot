# LINE Developers > Basic settings > Channel secret
LINE_CHANNEL_SECRET=
# LINE Developers > Messaging API > Channel access token
LINE_CHANNEL_ACCESS_TOKEN=
# Optional: an existing HTTPS URL for this server (without /line/webhook)
PUBLIC_BASE_URL=
# Enable simulated payments for the portfolio demo. No real charges occur.
ENABLE_MOCK_PAYMENT=true
# Optional: protect manual payment callbacks and local administration APIs.
DEMO_ADMIN_KEY=
HOST=127.0.0.1
PORT=5000
